  <!-- SCRIPT: Lenis + GSAP Choreography + Interactive Cursor -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // 1. Lenis Smooth Scroll Setup (epic.net feeling)
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1,
    });

    function raf(time) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);

    // Sync GSAP ScrollTrigger with Lenis
    gsap.registerPlugin(ScrollTrigger);
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    // 2. Custom Magnetic/Fluid Cursor
    const cursor = document.getElementById('cursor');
    let mouse = { x: 0, y: 0 };
    let pos = { x: 0, y: 0 };
    const speed = 0.2;

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    gsap.ticker.add(() => {
      pos.x += (mouse.x - pos.x) * speed;
      pos.y += (mouse.y - pos.y) * speed;
      gsap.set(cursor, { x: pos.x, y: pos.y });
    });

    // Hover Targets expanding cursor
    const hoverTargets = document.querySelectorAll('.hover-target, a, button, .experience-row');
    hoverTargets.forEach((el) => {
      el.addEventListener('mouseenter', () => {
        cursor.classList.add('w-14', 'h-14', 'bg-accent');
        cursor.classList.remove('w-4', 'h-4', 'bg-white');
        if (el.classList.contains('experience-row')) {
          cursor.innerText = "VIEW";
        }
      });
      el.addEventListener('mouseleave', () => {
        cursor.classList.remove('w-14', 'h-14', 'bg-accent');
        cursor.classList.add('w-4', 'h-4', 'bg-white');
        cursor.innerText = "";
      });
    });

    // 3. GSAP Entry Animations
    window.addEventListener('DOMContentLoaded', () => {
      // Hero elements reveal
      gsap.from('.hero-title', {
        y: 80,
        opacity: 0,
        duration: 1.3,
        ease: 'power4.out',
        stagger: 0.15
      });

      gsap.from('.hero-fade', {
        y: 30,
        opacity: 0,
        duration: 1,
        ease: 'power3.out',
        stagger: 0.1,
        delay: 0.4
      });

      // Manifesto text scroll triggers
      gsap.utils.toArray('.reveal-text').forEach((text) => {
        gsap.from(text, {
          scrollTrigger: {
            trigger: text,
            start: 'top 85%',
            toggleActions: 'play none none reverse',
          },
          y: 40,
          opacity: 0.2,
          duration: 1,
          ease: 'power2.out',
        });
      });

      // Experience timeline cascade
      gsap.utils.toArray('.experience-row').forEach((row, i) => {
        gsap.from(row, {
          scrollTrigger: {
            trigger: row,
            start: 'top 88%',
          },
          y: 35,
          opacity: 0,
          duration: 0.8,
          delay: i * 0.08,
          ease: 'power3.out'
        });
      });
    });

    // 4. Live IST Indian Clock
    function updateClock() {
      const now = new Date();
      const options = { timeZone: 'Asia/Kolkata', hour12: false, hour: '2-digit', minute: '2-digit' };
      const istString = now.toLocaleTimeString('en-GB', options);
      const clockEl = document.getElementById('delhi-time');
      if (clockEl) clockEl.textContent = istString + " IST";
    }
    setInterval(updateClock, 1000);
    updateClock();

    // 5. Click to Copy Email Toast
    const copyBtn = document.getElementById('copy-btn');
    const copyText = document.getElementById('copy-text');
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('shaunavofficial@gmail.com');
      const originalText = copyText.innerText;
      copyText.innerText = "COPIED TO CLIPBOARD!";
      copyBtn.classList.add('bg-accent');
      setTimeout(() => {
        copyText.innerText = originalText;
        copyBtn.classList.remove('bg-accent');
      }, 2200);
    });
  </script>
