    }
    @media (pointer: coarse) {
      .custom-cursor { display: none !important; }
    }

    /* Kinetic Marquee */
    @keyframes marquee {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    .animate-marquee {
      display: flex;
      width: 200%;
